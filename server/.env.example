PORT=5050
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=omni_hr
POSTGRES_PORT=5432

# Application Database Connection URL
DATABASE_URL=postgresql://postgres:your_secure_db_password_here@localhost:5432/omni_hr

# JWT Authentication Secrets
JWT_SECRET=replace_with_a_secure_jwt_secret_in_production
JWT_REFRESH_SECRET=replace_with_a_secure_refresh_secret_in_production
